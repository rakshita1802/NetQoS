# =================================================================
# NetQoS Enterprise Gateway - Environment Configuration
# =================================================================

# Server Network Configuration
ROUTER_HOST=0.0.0.0
ROUTER_API_PORT=8000
ROUTER_TCP_INGRESS_PORT=9000
ROUTER_UDP_INGRESS_PORT=9001

# Egress Forwarding Target
FORWARD_HOST=127.0.0.1
FORWARD_FILE_PORT=9005
FORWARD_VIDEO_PORT=9006

# QoS & Traffic Shaping Parameters
TOKEN_BUCKET_RATE_BPS=1000000
TOKEN_BUCKET_CAPACITY_BYTES=100000
OUTPUT_BANDWIDTH_BPS=10000000

# Telemetry & Database
DATABASE_URL=sqlite:///./netqos.db
PROMETHEUS_METRICS_ENABLED=true
